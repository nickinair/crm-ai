# CRM Backend 环境变量示例
# 复制为 .env 并填入真实值；.env 不会被提交到 Git

# 数据库配置
DB_HOST=your-db-host
DB_PORT=3306
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=crm_sales

# JWT 配置
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=7d

# 服务
PORT=3000
TZ=Asia/Shanghai

# 智能体平台开放接口（/api/open/agent，服务间调用）。令牌不少于 32 位随机串，与智能体平台的 CRM_SERVICE_TOKEN 一致；不配置则接口不可用
AGENT_SERVICE_TOKEN=
# 来源 IP 白名单（逗号分隔，留空不限制）。CRM 在 Nginx 后面时这里看到的是 Nginx 地址，改为在 Nginx 上对 /api/open/agent/ 做 allow/deny
AGENT_ALLOWED_IPS=
